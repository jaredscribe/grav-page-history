<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Recent Changes</title>
    <meta name="robots" content="noindex,follow">
</head>
<body>
    <h1>Recent Changes</h1>
    {% if history_available and history_entries is not empty %}
    <ul class="page-history__list">
        {% for entry in history_entries %}
        <li>
            <code>{{ entry.short_hash }}</code>
            <time datetime="{{ entry.date }}">{{ entry.date|date('Y-m-d H:i') }}</time>
            {% if entry.author %}<span>{{ entry.author }}</span>{% endif %}
            — {{ entry.subject }}
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <p>No history available.</p>
    {% endif %}
</body>
</html>
